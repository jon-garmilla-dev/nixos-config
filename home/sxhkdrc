alt + Return
	kitty

alt + d

alt + shift + q
	bspc node -c

alt + f
	bspc node -t ~fullscreen

alt + shift + space
	bspc node -t ~floating

alt + space
	bspc node -f next.floating || bspc node -f next.tiled

alt + {j,k,l,ntilde}
	bspc node -f {west,south,north,east}

alt + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

alt + shift + {j,k,l,ntilde}
	dir={west,south,north,east}; bspc node -s "$dir.local" --follow || bspc node -m "$dir" --follow

alt + shift + {Left,Down,Up,Right}
	dir={west,south,north,east}; bspc node -s "$dir.local" --follow || bspc node -m "$dir" --follow

super + shift + {h,j,k,l}
	dir={west,south,north,east}; bspc node -s "$dir.local" --follow || bspc node -m "$dir" --follow

alt + {1-9,0}
	bspc desktop -f '{1-9,10}'

alt + shift + {1-9,0}
	bspc node -d '{1-9,10}'

alt + shift + r
	bspc wm -r

super + alt + j
	bspc node -z left -20 0 || bspc node -z right -20 0

super + alt + k
	bspc node -z bottom 0 20 || bspc node -z top 0 20

super + alt + l
	bspc node -z top 0 -20 || bspc node -z bottom 0 -20

super + alt + ntilde
	bspc node -z right 20 0 || bspc node -z left 20 0

super + alt + Left
	bspc node -z left -20 0 || bspc node -z right -20 0

super + alt + Down
	bspc node -z bottom 0 20 || bspc node -z top 0 20

super + alt + Up
	bspc node -z top 0 -20 || bspc node -z bottom 0 -20

super + alt + Right
	bspc node -z right 20 0 || bspc node -z left 20 0

alt + shift + c
	pkill -USR1 -x sxhkd

alt + shift + e
	bspc quit

ctrl + alt + s
    scrot -s "$HOME/Pictures/screenshots/%Y-%m-%d_%H-%M-%S.png" -e 'xclip -selection clipboard -t image/png < $f'
